{
  "command_name": "ek-ldapsearch",
  "help": "Executes LDAP query",
  "extension_author": "Adaptix-Framework",
  "original_author": "Adaptix-Framework",
  "repo_url": "https://github.com/Adaptix-Framework/Extension-Kit",
  "version": "1.0.0",
  "entrypoint": "go",
  "files": [
    {
      "os": "windows",
      "arch": "amd64",
      "path": "ldapsearch.x64.o"
    }
  ],
  "arguments": [
    {
      "name": "query",
      "desc": "LDAP filter query",
      "type": "Z",
      "optional": false
    },
    {
      "name": "attributes",
      "desc": "Attributes to retrieve",
      "type": "z",
      "optional": true,
      "default": "*"
    },
    {
      "name": "count",
      "desc": "Result max size (0=unlimited)",
      "type": "i",
      "optional": true,
      "default": 0
    },
    {
      "name": "scope",
      "desc": "Scope: 1=BASE, 2=LEVEL, 3=SUBTREE",
      "type": "i",
      "optional": true,
      "default": 3
    },
    {
      "name": "dc",
      "desc": "DC hostname or IP",
      "type": "z",
      "optional": true,
      "default": ""
    },
    {
      "name": "dn",
      "desc": "LDAP query base DN",
      "type": "z",
      "optional": true,
      "default": ""
    },
    {
      "name": "ldaps",
      "desc": "Use LDAPS (1=yes)",
      "type": "i",
      "optional": true,
      "default": 0
    }
  ]
}