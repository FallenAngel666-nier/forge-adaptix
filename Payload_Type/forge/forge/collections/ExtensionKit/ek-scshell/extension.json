{
  "command_name": "ek-scshell",
  "help": "Spawn a session on a remote target via SCShell",
  "extension_author": "Adaptix-Framework",
  "original_author": "Adaptix-Framework",
  "repo_url": "https://github.com/Adaptix-Framework/Extension-Kit",
  "version": "1.0.0",
  "entrypoint": "go",
  "files": [
    {
      "os": "windows",
      "arch": "amd64",
      "path": "scshell.x64.o"
    },
    {
      "os": "windows",
      "arch": "386",
      "path": "scshell.x86.o"
    }
  ],
  "arguments": [
    {
      "name": "target",
      "desc": "Remote target",
      "type": "z",
      "optional": false
    },
    {
      "name": "svc_name",
      "desc": "Service name to modify",
      "type": "z",
      "optional": true,
      "default": "defragsvc"
    },
    {
      "name": "remote_unc_path",
      "desc": "Remote UNC path for binary",
      "type": "z",
      "optional": true,
      "default": ""
    },
    {
      "name": "binary",
      "desc": "Binary file",
      "type": "b",
      "optional": false
    }
  ]
}